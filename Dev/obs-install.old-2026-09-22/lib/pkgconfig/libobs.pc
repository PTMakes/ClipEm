prefix=/home/pt/Development/PTMClipEm/Dev/obs-install
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libobs
Description: OBS Studio core compositor library
Version: 32.2.2

Requires:
Libs: -L${libdir} -lobs
Libs.private: -pthread -lm
Cflags: -I${includedir} -std=gnu17 -fPIC -fvisibility=hidden -fopenmp-simd -Werror -DHAVE_OBSCONFIG_H
